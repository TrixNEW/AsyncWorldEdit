{
    "name": "trixnew/async-world-edit",
    "description": "Bounded, chunk-oriented world editing for Quark 6",
    "type": "quark-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "php-64bit": "*",
        "ext-zlib": "*",
        "pocketmine/nbt": "~1.2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "trixnew/vow": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Trix\\WorldEdit\\": "src/Trix/WorldEdit/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "build": "@php -d phar.readonly=0 tools/build.php",
        "bench": "@php tests/benchmarks/engine.php",
        "analyse:core": "phpstan analyse -c phpstan-core.neon --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [{
        "name": "vow",
        "type": "vcs",
        "url": "https://github.com/TrixNEW/Vow"
    }]
}
